# Build locally for testing (much faster than cloud build for iteration)
build_local() {
    echo "Building image locally with BuildKit"
    DOCKER_BUILDKIT=1 docker build -t $GCLOUD_IMAGE:$GCLOUD_TAG .
}

# Build locally using remote base (fastest for code changes)
build_local_fast() {
    echo "Building image locally using remote base (fast mode)"
    DOCKER_BUILDKIT=1 docker build --build-arg USE_REMOTE_BASE=true -t $GCLOUD_IMAGE:$GCLOUD_TAG .
}

# Build only base stage locally (for testing dependency changes)
build_local_base() {
    echo "Building base image (dependencies only) locally with BuildKit"
    DOCKER_BUILDKIT=1 docker build --target base -t $GCLOUD_IMAGE:base .
}

# Run a container in the foreground (no -d, no --rm) to capture crash output
# Usage: debug_remote_preprocess [script_name]
debug_remote_preprocess() {
    local script="${1:-preprocessing/prepare_training_data.py}"
    echo "Running preprocessing in foreground on $INSTANCE_NAME (output streamed here)"
    local gpu_flag=""
    if [ "${USE_GPU:-false}" = "true" ]; then gpu_flag="--gpus all"; fi
    local name="${CONTAINER_NAME:-ip3g-debug}"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo docker run --pull=never --name $name $gpu_flag \
        -v $GCLOUD_MOUNT_POINT/GTEX_phenotype:/app/GTEX_phenotype:ro \
        -v $GCLOUD_MOUNT_POINT/gtex_RSEM_Hugo_norm_count:/app/gtex_RSEM_Hugo_norm_count:ro \
        -v $GCLOUD_MOUNT_POINT/gtex_gene_expected_count:/app/gtex_gene_expected_count:ro \
        -v $VM_OUTPUT_BASE/preprocessing:/app/output/preprocessing \
        $GCLOUD_ARTIFACTORY_HOST/$GCLOUD_PROJECT_NAME/$GCLOUD_REPO/$GCLOUD_IMAGE:$GCLOUD_TAG $script; \
        sudo docker rm $name"
}

# Run diffusion/diagnostics.py on the VM against a saved checkpoint.
# Streams output directly here (no -d), then deletes all diagnostic outputs except
# training_history files (model weights are large and no longer needed after analysis).
# Usage: run_remote_diagnostics [checkpoint_path] [mode]
# Defaults: final diagnostic checkpoint, mode=diagnostic
# Examples:
#   run_remote_diagnostics
#   run_remote_diagnostics output/diffusion/remote/checkpoints/diffusion_model_final.weights.h5 remote
run_remote_diagnostics() {
    local checkpoint="${1:-output/diffusion/diagnostic/checkpoints/diffusion_model_final.weights.h5}"
    local mode="${2:-diagnostic}"
    local name="${CONTAINER_NAME:-ip3g-diagnostics}"
    echo "Running diagnostics on $INSTANCE_NAME"
    echo "  Checkpoint: $checkpoint"
    echo "  Mode: $mode"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo docker run --pull=never --rm --name $name \
        -v $GCLOUD_MOUNT_POINT/GTEX_phenotype:/app/GTEX_phenotype:ro \
        -v $GCLOUD_MOUNT_POINT/gtex_RSEM_Hugo_norm_count:/app/gtex_RSEM_Hugo_norm_count:ro \
        -v $GCLOUD_MOUNT_POINT/gtex_gene_expected_count:/app/gtex_gene_expected_count:ro \
        -v $VM_OUTPUT_BASE/preprocessing:/app/output/preprocessing:ro \
        -v $VM_OUTPUT_BASE/diffusion/remote:/app/output/diffusion/remote:ro \
        -v $VM_OUTPUT_BASE/diffusion/diagnostic:/app/output/diffusion/diagnostic:ro \
        $GCLOUD_ARTIFACTORY_HOST/$GCLOUD_PROJECT_NAME/$GCLOUD_REPO/$GCLOUD_IMAGE:$GCLOUD_TAG \
        diffusion/diagnostics.py --checkpoint $checkpoint --mode $mode"
    echo "Cleaning up diagnostic outputs (keeping training_history files)..."
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="\
        sudo find $VM_OUTPUT_BASE/diffusion/diagnostic -type f \
            ! -name 'training_history*.png' \
            ! -name 'training_history*.npz' \
            -delete && echo 'Cleanup complete'"
}
