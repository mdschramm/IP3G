# ============================================================
# QUICK REFERENCE — Common workflows (source this file first)
# ============================================================
#
# DEPLOY (after any code change):
#   push_gcloud_image_fast
#
# PREPROCESS (once, or when raw data changes):
#   enable_permissions_on_output_dir_for_docker
#   USE_GPU=false CONTAINER_NAME=ip3g-preprocess run_remote_preprocess
#   CONTAINER_NAME=ip3g-preprocess tail_logs
#   push_preprocessing_to_gcs
#
# TRAIN A MODEL (preprocessing must already be on VM or in GCS):
#   pull_preprocessing_from_gcs       # skip if already on VM this session
#   run_remote "diffusion/diffusion_train.py --mode remote"      # detached; use tail_logs to follow
#   run_remote_fg "diffusion/diffusion_train.py --mode diagnostic"  # foreground; output streams here
#   tail_logs
#   push_output_to_gcs diffusion      # or: gan, classifier
#
# GET RESULTS LOCALLY:
#   download_output_from_gcs
#
# RUN DIAGNOSTICS (after any training or diagnostic run):
#   run_remote_diagnostics                                                                          # diagnostic checkpoint (default)
#   run_remote_diagnostics output/diffusion/remote/checkpoints/diffusion_model_step_010000.weights.h5 remote
#
# RE-AUTH (if Docker pull fails with "unauthorized" error):
#   docker_login_remote
#
# FIRST-TIME VM SETUP (new VM only): *runs on debian 12 bookworm*
