GCLOUD_PROJECT_NAME="anita-hunter"
GCLOUD_MAIN_ACCOUNT="mschramm@gradcenter.cuny.edu"
GCLOUD_SERVICE_ACCOUNT="309851949944-compute@developer.gserviceaccount.com"
GCLOUD_REGION_ARTIFACTS="us-east1"
INSTANCE_NAME="mark-test-instance"
GCLOUD_ARTIFACTORY_HOST="$GCLOUD_REGION_ARTIFACTS-docker.pkg.dev"
GCLOUD_REPO="mark-ip3g-repo"
GCLOUD_IMAGE="ip3g"
GCLOUD_TAG="latest"
GCLOUD_INSTANCE_ZONE="us-central1-b"
# Get this from cat /etc/os-release on VM - look for VERSION_CODENAME
# prepend gcsfuse- to the value
GCSFUSE_REPO="gcsfuse-jammy"  # Ubuntu 22.04 (Jammy Jellyfish)
GCS_BUCKET_NAME="mark-ip3g-data"
GCLOUD_MOUNT_POINT="/mnt/gcs/mark-ip3g-data"
USE_GPU=true

NVIDIA_CONTAINER_TOOLKIT_VERSION="1.18.0-1"


set_gcloud_project_settings() {
    gcloud auth login
    gcloud config set project $GCLOUD_PROJECT_NAME
    gcloud auth configure-docker $GCLOUD_ARTIFACTORY_HOST
    gcloud config set account $GCLOUD_MAIN_ACCOUNT
}

install_gcsfuse() {
    echo "Installing gcsfuse on $INSTANCE_NAME"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="echo \"deb https://packages.cloud.google.com/apt $GCSFUSE_REPO main\" | sudo tee /etc/apt/sources.list.d/gcsfuse.list"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="curl https://packages.cloud.google.com/apt/doc/apt-key.gpg | sudo apt-key add -"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo apt-get update && sudo apt-get install -y gcsfuse"
}

mount_volumes() {
    echo "Mounting volumes for docker process"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo mkdir -p $GCLOUD_MOUNT_POINT"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo gcsfuse $GCS_BUCKET_NAME $GCLOUD_MOUNT_POINT"
}

# Pulls latest docker images on instance and mount volumes
set_up_docker_image() {
    echo "Installing dependencies on $INSTANCE_NAME and pulling image"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo apt-get update && sudo apt-get install -y docker.io"
    
    docker_login_command="gcloud auth print-access-token | sudo docker login -u oauth2accesstoken --password-stdin https://$GCLOUD_ARTIFACTORY_HOST"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="$docker_login_command"
    
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo docker pull $GCLOUD_ARTIFACTORY_HOST/$GCLOUD_PROJECT_NAME/$GCLOUD_REPO/$GCLOUD_IMAGE:$GCLOUD_TAG"

    install_gcsfuse

    mount_volumes
}

# Runs docker image after it's pulled
run_docker_image() {
    echo "Running docker image on $INSTANCE_NAME"
    local gpu_flag=""
    if [ "${USE_GPU:-false}" = "true" ]; then gpu_flag="--gpus all"; fi
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo docker run --pull=always $gpu_flag --rm -it -v $GCLOUD_MOUNT_POINT/GTEX_phenotype:/app/GTEX_phenotype:ro -v $GCLOUD_MOUNT_POINT/gtex_RSEM_Hugo_norm_count:/app/gtex_RSEM_Hugo_norm_count:ro -v $GCLOUD_MOUNT_POINT/gtex_gene_expected_count:/app/gtex_gene_expected_count:ro $GCLOUD_ARTIFACTORY_HOST/$GCLOUD_PROJECT_NAME/$GCLOUD_REPO/$GCLOUD_IMAGE:$GCLOUD_TAG" -- -t
}

## Pushing builds to registry
# Full build: builds base + runtime from scratch (use when dependencies change)
push_gcloud_image() {
    echo "Pushing image to gcloud"
    DOCKER_BUILDKIT=1 gcloud builds submit --region=$GCLOUD_REGION_ARTIFACTS --config cloudbuild.yaml
}

# Push base image with :base tag (do this once, or when environment.yml changes)
push_gcloud_base_image() {
    echo "Pushing base image (dependencies only) to gcloud"
    DOCKER_BUILDKIT=1 gcloud builds submit --region=$GCLOUD_REGION_ARTIFACTS --config cloudbuild.yaml --substitutions=_TARGET=base,_TAG=base
}

# Fast build: uses remote base image, only builds runtime layer (use for code changes)
push_gcloud_image_fast() {
    echo "Pushing runtime image using remote base (fast mode)"
    DOCKER_BUILDKIT=1 gcloud builds submit --region=$GCLOUD_REGION_ARTIFACTS --config cloudbuild.yaml --substitutions=_USE_REMOTE_BASE=true
}

# Build locally for testing (much faster than cloud build for iteration)
build_local() {
    echo "Building image locally with BuildKit"
    DOCKER_BUILDKIT=1 docker build -t $GCLOUD_IMAGE:$GCLOUD_TAG .
}

# Build locally using remote base (fastest for code changes)
build_local_fast() {
    echo "Building image locally using remote base (fast mode)"
    DOCKER_BUILDKIT=1 docker build --build-arg USE_REMOTE_BASE=true -t $GCLOUD_IMAGE:$GCLOUD_TAG .
}

# Build only base stage locally (for testing dependency changes)
build_local_base() {
    echo "Building base image (dependencies only) locally with BuildKit"
    DOCKER_BUILDKIT=1 docker build --target base -t $GCLOUD_IMAGE:base .
}

# Force-kill any running containers of this image on the VM
force_kill_ip3g_containers() {
    echo "Force-killing containers for image $GCLOUD_IMAGE on $INSTANCE_NAME"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="bash -lc 'ids=\$(sudo docker ps -q --filter ancestor=$GCLOUD_ARTIFACTORY_HOST/$GCLOUD_PROJECT_NAME/$GCLOUD_REPO/$GCLOUD_IMAGE:$GCLOUD_TAG); if [ -n \"\$ids\" ]; then sudo docker kill \$ids; else echo \"No running containers matching that image\"; fi'"
}

# Force-kill all running containers on the VM (use with caution)
force_kill_all_containers() {
    echo "Force-killing all running containers on $INSTANCE_NAME"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="bash -lc 'ids=\$(sudo docker ps -q); if [ -n \"\$ids\" ]; then sudo docker kill \$ids; else echo \"No running containers\"; fi'"
}

enable_permissions_on_output_dir_for_docker() {
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo mkdir ~/loaded_data"
}

# Run the container detached and named, so you can tail logs or exec a shell
# Usage: run_docker_image_detached [script_name]
# Example: run_docker_image_detached "model.py" or run_docker_image_detached (uses default)
run_docker_image_detached() {
    local script="${1:-}"  # Optional script argument, empty string if not provided
    echo "Running docker image (detached) on $INSTANCE_NAME"
    local gpu_flag=""
    if [ "${USE_GPU:-false}" = "true" ]; then gpu_flag="--gpus all"; fi
    local name="${CONTAINER_NAME:-ip3g}"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo docker run --pull=always --rm -d --name $name $gpu_flag -v $GCLOUD_MOUNT_POINT/GTEX_phenotype:/app/GTEX_phenotype:ro -v $GCLOUD_MOUNT_POINT/gtex_RSEM_Hugo_norm_count:/app/gtex_RSEM_Hugo_norm_count:ro -v $GCLOUD_MOUNT_POINT/gtex_gene_expected_count:/app/gtex_gene_expected_count:ro -v ~/loaded_data:/app/loaded_data $GCLOUD_ARTIFACTORY_HOST/$GCLOUD_PROJECT_NAME/$GCLOUD_REPO/$GCLOUD_IMAGE:$GCLOUD_TAG $script"
}

run_script_detached() {
    command=""
}


tail_ip3g_logs() {
    local name="${CONTAINER_NAME:-ip3g}"
    echo "Tailing logs for container $name on $INSTANCE_NAME (Ctrl+C to stop)"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo docker logs -f $name"
}

stop_ip3g_container() {
    local name="${CONTAINER_NAME:-ip3g}"
    echo "Stopping container $name on $INSTANCE_NAME"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo docker stop $name || true"
}

install_nvidia_gpu_driver() {
    # ubuntu 22.04
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo apt update && sudo apt install -y build-essential && sudo apt install -y cmake"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo apt update && curl -L https://storage.googleapis.com/compute-gpu-installation-us/installer/latest/cuda_installer.pyz --output cuda_installer.pyz"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo python3 cuda_installer.pyz install_driver --installation-mode=binary --installation-branch=prod"
    # reboot instance and continue run
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo reboot"
    sleep 30
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo python3 cuda_installer.pyz install_driver --installation-mode=binary --installation-branch=prod"

    # install lub vulkan
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo apt install libvulkan1"

    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo python3 cuda_installer.pyz install_cuda --installation-mode=binary --installation-branch=prod"
    # reboot instance again and rerun
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo reboot"
    sleep 30
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo python3 cuda_installer.pyz install_cuda --installation-mode=binary --installation-branch=prod"    

    # verify cuda
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="python3 cuda_installer.pyz verify_cuda"
}



# Install and configure NVIDIA Container Toolkit on the VM for GPU passthrough
configure_nvidia_container_toolkit() {
    echo "Configuring NVIDIA Container Toolkit on $INSTANCE_NAME"
    # gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="bash -lc 'set -e; if ! command -v nvidia-smi >/dev/null 2>&1; then echo \"WARNING: NVIDIA driver not found on VM. Install the NVIDIA driver and reboot before using GPU.\"; fi; distribution=\$( . /etc/os-release; echo \$ID\$VERSION_ID ); curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | sudo gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg; curl -fsSL https://nvidia.github.io/libnvidia-container/\$distribution/libnvidia-container.list | sed \"s#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g\" | sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list > /dev/null; sudo apt-get update; sudo apt-get install -y nvidia-container-toolkit; sudo nvidia-ctk runtime configure --runtime=docker; sudo systemctl restart docker'"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo apt-get update && sudo apt-get install -y --no-install-recommends \
        curl \
        gnupg2"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | sudo gpg --dearmor -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg \
        && curl -s -L https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list | \
        sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' | \
        sudo tee /etc/apt/sources.list.d/nvidia-container-toolkit.list"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo apt-get update"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo apt-get install -y \
            nvidia-container-toolkit=$NVIDIA_CONTAINER_TOOLKIT_VERSION \
            nvidia-container-toolkit-base=$NVIDIA_CONTAINER_TOOLKIT_VERSION \
            libnvidia-container-tools=$NVIDIA_CONTAINER_TOOLKIT_VERSION \
            libnvidia-container1=$NVIDIA_CONTAINER_TOOLKIT_VERSION"
    gcloud compute ssh $INSTANCE_NAME --zone=$GCLOUD_INSTANCE_ZONE --command="sudo systemctl restart docker"
    
}

configure_docker_nvidia() {
    set_up_docker_image
    install_nvidia_gpu_driver
    configure_nvidia_container_toolkit
}

